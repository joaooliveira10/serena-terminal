# <% .Name %>: generated by `sereno export` from Serena Theme <% .Tag %>.
[colors]
foreground = "<% .Foreground %>"
background = "<% .Background %>"
cursor_bg = "<% .Cursor %>"
cursor_border = "<% .Cursor %>"
cursor_fg = "<% .Background %>"
selection_bg = "<% .SelectionBackground %>"
selection_fg = "<% .SelectionForeground %>"
ansi = [<% range $n, $c := .Normal %><% if $n %>, <% end %>"<% $c %>"<% end %>]
brights = [<% range $n, $c := .Bright %><% if $n %>, <% end %>"<% $c %>"<% end %>]

[metadata]
name = <% toml .Name %>
